{
  "name": "angular-radar",
  "displayName": "Angular Radar",
  "publisher": "Hatuos",
  "description": "A lightweight way for staying up to date with Angular releases",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hatuos/vscode-angular-radar.git"
  },
  "keywords": ["angular", "releases", "frontend"],
  "version": "0.1.0",
  "icon": "media/wizard128.png",
  "scripts": {
    "compile": "tsc -p ./"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "angularRadar.openReleases",
        "title": "Angular Radar: Open Releases"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "angularRadar",
          "title": "Angular Radar",
          "icon": "media/angular-radar.svg"
        }
      ]
    },
    "views": {
      "angularRadar": [
        {
          "id": "angularRadar.releases",
          "name": "Releases",
          "icon": "media/angular-radar.svg",
          "type": "webview"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.5.0"
}